# App URL — used for OG images, sitemap, and metadata.
# Leave unset for local development (defaults to http://localhost:3000).
NEXT_PUBLIC_APP_URL=https://datagraph.app

# Analytics — only loaded when this is set.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=datagraph.app

# API Keys
CEREBRAS_API_KEY=your_cerebras_api_key

# E2B Sandbox for code execution
E2B_API_KEY=your_e2b_api_key

# UploadThing for file uploads.
# v6+ uses UPLOADTHING_TOKEN; some pinned versions still expect
# UPLOADTHING_SECRET. If uploads return "No secret provided", set both.
# (Do NOT wrap values in single quotes — dotenv keeps quoted strings as-is.)
UPLOADTHING_TOKEN=your_uploadthing_token
UPLOADTHING_SECRET=your_uploadthing_secret

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
